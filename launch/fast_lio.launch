<launch>
  <arg name="rviz" default="false" />
  <rosparam command="load" file="$(find jaguar)/config/mid360_fastlio_config.yaml" />

  <param name="feature_extract_enable" type="bool" value="0"/>
  <param name="point_filter_num" type="int" value="3"/>
  <param name="max_iteration" type="int" value="3" />
  <param name="filter_size_surf" type="double" value="0.5" />
  <param name="filter_size_map" type="double" value="0.5" />
  <param name="cube_side_length" type="double" value="1000" />
  <param name="runtime_pos_log_enable" type="bool" value="0" />
  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"/>

  <node name="livox_odom_transform" pkg="jaguar" type="livox_odom_transform.py" output="screen" />

  <node name="livox_cloud_transform" pkg="jaguar" type="livox_cloud_transform.py" output="screen" />

  <node name="livox_self_filter" pkg="robot_self_filter" type="self_filter">
    <remap from="cloud_in" to="/cloud_registered_body_back" />
    <remap from="cloud_out" to="/cloud_registered_body_back_filtered" />
    <rosparam>
      sensor_frame: livox_back
      use_rgb: false
      keep_organized: true
      subsample_value: 0.0
      min_sensor_dist: 0.27
      self_see_default_padding: 0.04
      self_see_default_scale: 1.0
      self_see_links:
      - name: Fr_coxa_link
      - name: Fr_thigh_link
      - name: Fr_tibia_link
      - name: Fl_coxa_link
      - name: Fl_thigh_link
      - name: Fl_tibia_link
      - name: Br_coxa_link
      - name: Br_thigh_link
      - name: Br_tibia_link
      - name: Bl_coxa_link
      - name: Bl_thigh_link
      - name: Bl_tibia_link
    </rosparam>
  </node>

  <node pkg="elevation_mapping_cupy" type="elevation_mapping_node" name="elevation_mapping" output="screen">
    <rosparam command="load" file="$(find jaguar)/config/elevation_core.yaml"/>
    <rosparam command="load" file="$(find jaguar)/config/elevation_jaguar.yaml"/>
  </node>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find jaguar)/config/jaguar.rviz" if="$(arg rviz)" />
</launch>
